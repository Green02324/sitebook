generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionMode {
  ESTIMATE
  ACTUAL
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projects          Project[]
  refreshTokens     RefreshToken[]
  overheadCategories OverheadCategory[]
  overheadExpenses  OverheadExpense[]
}

// Refresh-token rotation: each row is one issued refresh token. On every
// /auth/refresh call, the presented token's row is marked revoked and a new
// row+JWT is issued. Logout revokes the current row. Reuse of an
// already-revoked token is rejected, which reveals token theft.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Project {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  status               ProjectStatus @default(PLANNING)
  clientName           String?
  clientPhone          String?
  clientEmail          String?
  address              String?
  startDate            DateTime?     @db.Date
  targetCompletionDate DateTime?     @db.Date
  contractAmountCents  Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  categories           Category[]
  transactions         Transaction[]

  @@index([userId, createdAt])
}

model Category {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([projectId, name])
}

model Transaction {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        TransactionType
  mode        TransactionMode
  date        DateTime        @db.Date
  amountCents Int
  description String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, mode])
  @@index([categoryId])
}

// Business-wide expenses not tied to any project (advertising, vehicle,
// salary, insurance, etc.) — scoped directly by userId, same
// reusable-category pattern as project Category.
model OverheadCategory {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  expenses  OverheadExpense[]

  @@unique([userId, name])
}

model OverheadExpense {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    OverheadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date        DateTime          @db.Date
  amountCents Int
  description String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, date])
  @@index([categoryId])
}
