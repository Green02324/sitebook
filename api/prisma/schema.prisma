generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  // Sees every account and can drill into their data, but cannot change
  // anything — not their records, and not user management.
  ADMIN_READONLY
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionMode {
  ESTIMATE
  ACTUAL
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  role              Role               @default(USER)
  // Deactivated accounts can't sign in and their sessions are revoked, but
  // every project, line item and expense they own stays intact and readable
  // by admins. Null means active.
  deactivatedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projects          Project[]
  refreshTokens     RefreshToken[]
  overheadCategories OverheadCategory[]
  overheadExpenses  OverheadExpense[]
  // Fallback hourly rate for consulting engagements that don't set their own.
  // Null means no rate: hours are still tracked, just without a dollar value.
  consultingRateCents Int?
  consultingEngagements ConsultingEngagement[]
}

// Refresh-token rotation: each row is one issued refresh token. On every
// /auth/refresh call, the presented token's row is marked revoked and a new
// row+JWT is issued. Logout revokes the current row. Reuse of an
// already-revoked token is rejected, which reveals token theft.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Project {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  status               ProjectStatus @default(PLANNING)
  clientName           String?
  clientPhone          String?
  clientEmail          String?
  address              String?
  startDate            DateTime?     @db.Date
  targetCompletionDate DateTime?     @db.Date
  contractAmountCents  Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  categories           Category[]
  transactions         Transaction[]

  @@index([userId, createdAt])
}

model Category {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([projectId, name])
}

model Transaction {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        TransactionType
  mode        TransactionMode
  // Estimates are planned by construction phase rather than by date, so this
  // is optional; actuals still always carry one.
  date        DateTime?       @db.Date
  amountCents Int
  description String?
  notes       String?
  // Free-text construction phase ("Site work", "Frame", "Mids", "Finish").
  // Stored on the row rather than as its own table so a phase can be typed
  // once and offered thereafter, with no separate list to maintain.
  phase       String?
  // Manual position within a project's estimate, so line items can be put in
  // construction order. Null until a row has been moved; those sort last and
  // fall back to creation order, so existing data needs no backfill.
  sortOrder   Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, mode])
  @@index([categoryId])
}

// Business-wide expenses not tied to any project (advertising, vehicle,
// salary, insurance, etc.) — scoped directly by userId, same
// reusable-category pattern as project Category.
model OverheadCategory {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  expenses  OverheadExpense[]

  @@unique([userId, name])
}

model OverheadExpense {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    OverheadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date        DateTime          @db.Date
  amountCents Int
  description String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, date])
  @@index([categoryId])
}

// Consulting time tracking: a user billing hours (not materials) on someone
// else's project. Entirely separate from Project/Transaction — these never
// feed the dashboard, annual report, or any job's profit figures.
model ConsultingEngagement {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  clientName  String?
  // Where the "send" button addresses the email; optional.
  clientEmail String?
  // Hourly rate in cents. Null falls back to the account's default rate.
  rateCents   Int?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bills       ConsultingBill[]
  entries     ConsultingEntry[]
  expenses    ConsultingExpense[]
  payments    ConsultingPayment[]

  @@index([userId, createdAt])
}

// "Bill 1", "Bill 2"... — a batch of hours. New hours land on the highest
// numbered bill that is still open; closing one (by hand, or by recording a
// payment) makes the next entry start the next bill.
model ConsultingBill {
  id           String               @id @default(cuid())
  engagementId String
  engagement   ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  number       Int
  closedAt     DateTime?
  createdAt    DateTime             @default(now())
  entries      ConsultingEntry[]
  expenses     ConsultingExpense[]

  @@unique([engagementId, number])
}

model ConsultingEntry {
  id           String               @id @default(cuid())
  engagementId String
  engagement   ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  billId       String
  bill         ConsultingBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  date         DateTime             @db.Date
  // Whole minutes, so quarter-hours and the like sum exactly.
  minutes      Int
  summary      String?
  // Null floats with the engagement's current rate. Set when the bill closes,
  // so a bill that's been sent doesn't change total if the rate later does.
  rateCents    Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([engagementId, date])
  @@index([billId])
}

// Costs paid out of pocket (materials, permit fees...) to be billed back. They
// sit on bills alongside hours and are paid off the same way.
model ConsultingExpense {
  id           String               @id @default(cuid())
  engagementId String
  engagement   ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  billId       String
  bill         ConsultingBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  date         DateTime             @db.Date
  amountCents  Int
  category     String
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  // Checks received specifically to reimburse this expense.
  payments     ConsultingPayment[]

  @@index([engagementId, date])
  @@index([billId])
}

// Money received. Not tied to a single bill: payments are applied to the
// oldest charges first, so one check can clear a bill and carry on into the
// next — unless it names an expense, which it then pays off before anything else.
model ConsultingPayment {
  id           String               @id @default(cuid())
  engagementId String
  engagement   ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  date         DateTime             @db.Date
  amountCents  Int
  note         String?
  // Set when the money is a reimbursement for one particular expense. Deleting
  // the expense leaves the payment in place as an ordinary one.
  expenseId    String?
  expense      ConsultingExpense?   @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([engagementId, date])
  @@index([expenseId])
}
